      <column caption='Athletes' datatype='string' name='[Calculation_6687986197579665416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NOC] = &apos;NOR&apos; THEN &apos;Norway&apos;&#10;ELSE &apos;Other Regions&apos;&#10;END' />
      </column>
      <column caption='GoldMedals' datatype='integer' name='[Calculation_6687986198277529620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Medal] = &apos;Gold&apos; THEN 3&#10;ELSE 0&#10;END' />
      </column>
      <column caption='SilverMedals' datatype='integer' name='[Calculation_6687986198277644309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Medal] = &apos;Silver&apos; THEN 2&#10;ELSE 0&#10;END' />
      </column>
      <column caption='BronzeMedals' datatype='integer' name='[Calculation_6687986198277804054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Medal] = &apos;Bronze&apos; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='TotalMedals' datatype='integer' name='[Calculation_6687986198277963799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Medal] IN (&apos;Gold&apos;, &apos;Silver&apos;, &apos;Bronze&apos;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='CalculatedSport' datatype='string' name='[Calculation_6687986198283661338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NOC] = &apos;NOR&apos; THEN [Sport]&#10;END' />
      </column>
      <column aggregation='Sum' caption='Medals' datatype='integer' name='[Calculation_6687986198301958172]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Medal]&#10;    WHEN &apos;Gold&apos; THEN 1&#10;    WHEN &apos;Silver&apos; THEN 2&#10;    WHEN &apos;Bronze&apos; THEN 3&#10;END' />
        <aliases>
          <alias key='1' value='Gold' />
          <alias key='2' value='Silver' />
          <alias key='3' value='Bronze' />
        </aliases>
      </column>
      <column caption='Sort by Sport' datatype='integer' name='[Calculation_6687986198311444511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sport] = [Parameters].[Parameter 1] AND CONTAINS ([NOC], &apos;NOR&apos;) AND [Calculation_6687986198277963799] &gt; 0 THEN [Calculation_6687986198277963799] END' />
      </column>
      <column caption='NullMedals' datatype='string' name='[Calculation_6687986198315106337]' role='dimension' type='nominal'>
