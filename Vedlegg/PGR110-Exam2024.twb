      </column>
      <column caption='Total Medals' datatype='integer' name='[Calculation_2249829502291238913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Medal Parameter]&#13;&#10;    WHEN &quot;Gold&quot; THEN SUM([Calculation_2326672170576879616])&#13;&#10;    WHEN &quot;Silver&quot; THEN SUM([Calculation_2326672170577096705])&#13;&#10;    WHEN &quot;Bronze&quot; THEN SUM([Calculation_2326672170577215490])&#13;&#10;    ELSE SUM([Calculation_2326672170577367043])&#13;&#10;END' />
